{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator.md\""
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/skills/setup/connections.sh\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*commit*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-secrets.sh\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*commit*)",
            "shell": "powershell",
            "command": "$ms = New-Object IO.MemoryStream; [Console]::OpenStandardInput().CopyTo($ms); $i = (New-Object Text.UTF8Encoding($false)).GetString($ms.ToArray()); & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-secrets.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          },
          {
            "type": "command",
            "if": "Bash(*giT*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          },
          {
            "type": "command",
            "if": "Bash(*gIt*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          },
          {
            "type": "command",
            "if": "Bash(*gIT*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          },
          {
            "type": "command",
            "if": "Bash(*Git*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          },
          {
            "type": "command",
            "if": "Bash(*GiT*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          },
          {
            "type": "command",
            "if": "Bash(*GIt*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          },
          {
            "type": "command",
            "if": "Bash(*GIT*)",
            "shell": "bash",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.sh\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${GUYB_USAGE_DIR:-$HOME/.claude/guyb/usage}/state\" ] || exit 0; . \"${CLAUDE_PLUGIN_ROOT}/hooks/usage-guard.sh\" gate"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*git*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "if": "PowerShell(*giT*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "if": "PowerShell(*gIt*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "if": "PowerShell(*gIT*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "if": "PowerShell(*Git*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "if": "PowerShell(*GiT*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "if": "PowerShell(*GIt*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "if": "PowerShell(*GIT*)",
            "shell": "powershell",
            "command": "$i = [Console]::In.ReadToEnd(); if ($i -notmatch '\"agent_type\"\\s*:\\s*\"(guyb:)?(code-reviewer|architect|data-modeler|data-analyst|session-tracker|brand-designer)\"') { exit 0 }; & ([scriptblock]::Create([IO.File]::ReadAllText(\"${CLAUDE_PLUGIN_ROOT}/hooks/guard-readonly.ps1\"))) -Raw $i; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" running"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "asyncRewake": true,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" resume"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "asyncRewake": true,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" done"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" agent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "asyncRewake": true,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" agent-stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/tab-status.sh\" end"
          }
        ]
      }
    ]
  }
}
